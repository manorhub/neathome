# Copy to .env (never commit .env). Affiliate links stay DISABLED until
# the owner confirms domain registration in Amazon Associates Central
# AND supplies a real tracking tag.
AMAZON_ASSOCIATE_TAG=YOUR_ASSOCIATE_TAG_HERE
# AFFILIATE_ENABLED is read only as a build-time guard in docs;
# production code defaults to disabled. Do not set this to true
# until the tag above is real and neatapartment.org is registered.
AFFILIATE_ENABLED=false
