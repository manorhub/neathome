---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { readingTimeMinutes } from '../lib/seo';
import { resolveRelatedPosts } from '../lib/internal-links';

export async function getStaticPaths() {
  const now = new Date();
  const posts = await getCollection('posts', ({ data }) => {
    return !data.draft && data.pubDate.getTime() <= now.getTime();
  });
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = await resolveRelatedPosts(post.data.relatedPosts);
const readingTime = readingTimeMinutes(post.body ?? '');
---
<ArticleLayout post={post} readingTime={readingTime} related={related}>
  <Content />
</ArticleLayout>
