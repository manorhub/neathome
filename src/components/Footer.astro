---
import { CATEGORIES, SITE } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-border bg-white">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <p class="font-serif text-xl font-bold text-forest">{SITE.name}</p>
    <p class="mt-2 max-w-xl text-muted">{SITE.tagline}</p>
    <div class="mt-6 grid gap-8 sm:grid-cols-3">
      <nav aria-label="Categories">
        <h2 class="font-sans text-sm font-bold uppercase tracking-wide">Categories</h2>
        <ul class="mt-3 space-y-2">
          {CATEGORIES.map((c) => (
            <li><a href={`/${c.slug}/`}>{c.title}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label="About">
        <h2 class="font-sans text-sm font-bold uppercase tracking-wide">About</h2>
        <ul class="mt-3 space-y-2">
          <li><a href="/about/">About</a></li>
          <li><a href="/affiliate-disclosure/">Affiliate Disclosure</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="font-sans text-sm font-bold uppercase tracking-wide">Disclosure</h2>
        <p class="mt-3 text-sm text-muted">
          As an Amazon Associate I earn from qualifying purchases. See our
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a> for details.
        </p>
      </div>
    </div>
    <p class="mt-10 border-t border-border pt-4 text-sm text-muted">
      © {year} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>
