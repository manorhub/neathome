---
import { AFFILIATE, isAffiliateReady } from '../config/affiliate';
import { validateAffiliateUrl } from '../lib/affiliate-validation';

export interface Product {
  name: string;
  type: string;
  whyUseful: string;
  bestUseCase: string;
  drawback: string;
  amazonUrl?: string;
  dimensions?: string;
  material?: string;
}
interface Props {
  product: Product;
  label?: string;
}
const { product, label } = Astro.props;
const ready = isAffiliateReady();
const validation = product.amazonUrl
  ? validateAffiliateUrl(product.amazonUrl, undefined, ready)
  : { ok: false, reason: 'No verified product link yet.' };
// While affiliate mode is disabled, never render a link to Amazon and never
// render the placeholder tag. The button below is intentionally disabled.
---
<article class="rounded border border-border bg-white p-5">
  {label && <p class="text-sm font-bold uppercase tracking-wide text-forest">{label}</p>}
  <h3 class="mt-2 font-serif text-xl">{product.name}</h3>
  <p class="text-sm text-muted">{product.type}</p>
  <p class="mt-3"><strong>Why it may be useful:</strong> {product.whyUseful}</p>
  <p class="mt-2"><strong>Best use case:</strong> {product.bestUseCase}</p>
  {product.dimensions && <p class="mt-2"><strong>Dimensions:</strong> {product.dimensions}</p>}
  {product.material && <p class="mt-2"><strong>Material:</strong> {product.material}</p>}
  <p class="mt-2"><strong>Honest drawback:</strong> {product.drawback}</p>
  {ready && validation.ok && product.amazonUrl ? (
    <p class="mt-4">
      <a href={product.amazonUrl} rel="sponsored nofollow noopener" target="_blank" class="inline-block rounded bg-forest px-4 py-2 text-white">Check current price on Amazon</a>
    </p>
  ) : (
    <div class="mt-4">
      <button type="button" disabled class="cursor-not-allowed rounded bg-sage px-4 py-2 text-charcoal opacity-70">Check current price on Amazon — coming soon</button>
      <p class="mt-2 text-sm text-muted">{AFFILIATE.warning} No product rating, price, dimension, or stock claim is shown until live verification is completed.</p>
    </div>
  )}
  <p class="mt-2 text-sm text-muted">As an Amazon Associate I earn from qualifying purchases.</p>
</article>
