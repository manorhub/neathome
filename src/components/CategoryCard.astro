---
interface Props {
  title: string;
  href: string;
  description: string;
  image: string;
  imageAlt: string;
}
const { title, href, description, image, imageAlt } = Astro.props;
---
<article class="overflow-hidden rounded border border-border bg-white">
  <a href={href} aria-label={title}>
    <img src={image} alt={imageAlt} width="800" height="500" loading="lazy" class="h-44 w-full object-cover" />
  </a>
  <div class="p-5">
    <h3 class="font-serif text-xl"><a href={href}>{title}</a></h3>
    <p class="mt-2 text-muted">{description}</p>
    <p class="mt-3"><a href={href}>Browse {title} →</a></p>
  </div>
</article>
