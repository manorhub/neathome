---
import { CATEGORIES } from '../config/site';
---
<header class="border-b border-border bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="flex items-center gap-2 text-forest" aria-label="Neat Apartment home">
      <svg width="36" height="36" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <path d="M8 22 24 8l16 14" stroke="#234638" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M12 20v18h24V20" stroke="#234638" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M18 30h12M18 35h12" stroke="#234638" stroke-width="2.5" stroke-linecap="round" />
      </svg>
      <span class="font-serif text-2xl font-bold">Neat Apartment</span>
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-5 lg:flex">
      <a href="/">Home</a>
      {CATEGORIES.map((c) => (
        <a href={`/${c.slug}/`}>{c.title}</a>
      ))}
      <a href="/search/" aria-label="Search articles">Search</a>
    </nav>
    <details class="lg:hidden">
      <summary class="cursor-pointer rounded border border-border px-3 py-2">Menu</summary>
      <nav aria-label="Mobile" class="absolute right-4 z-20 mt-2 flex w-64 flex-col gap-2 rounded border border-border bg-white p-4 shadow">
        <a href="/">Home</a>
        {CATEGORIES.map((c) => (
          <a href={`/${c.slug}/`}>{c.title}</a>
        ))}
        <a href="/search/">Search</a>
        <a href="/about/">About</a>
        <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
      </nav>
    </details>
  </div>
</header>
