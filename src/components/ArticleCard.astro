---
import { categoryBySlug } from '../config/site';
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  pubDate: Date;
  heroImage: string;
  heroImageAlt: string;
  readingTime: number;
}
const { title, description, href, category, pubDate, heroImage, heroImageAlt, readingTime } = Astro.props;
const cat = categoryBySlug(category);
---
<article class="overflow-hidden rounded border border-border bg-white">
  <a href={href} aria-label={title}>
    <img src={heroImage} alt={heroImageAlt} width="800" height="500" loading="lazy" class="h-48 w-full object-cover" />
  </a>
  <div class="p-5">
    {cat && <p class="text-sm font-bold uppercase tracking-wide text-forest">{cat.title}</p>}
    <h3 class="mt-2 font-serif text-xl"><a href={href}>{title}</a></h3>
    <p class="mt-2 text-muted">{description}</p>
    <p class="mt-3 text-sm text-muted">
      <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      · {readingTime} min read
    </p>
    <p class="mt-3"><a href={href}>Read the guide →</a></p>
  </div>
</article>
